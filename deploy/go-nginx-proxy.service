[Unit]
Description=go-nginx-proxy - nginx reverse proxy manager
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/go-nginx-proxy.env
ExecStart=/usr/local/bin/go-nginx-proxy
Restart=on-failure
RestartSec=3
# NOTE: no ProtectSystem/ReadWritePaths here — the service shells out to
# nginx -t / systemctl / certbot which need access to /run, /var/log, etc.

[Install]
WantedBy=multi-user.target
