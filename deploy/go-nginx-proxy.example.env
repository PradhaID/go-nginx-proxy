# go-nginx-proxy environment (systemd: EnvironmentFile=/etc/go-nginx-proxy.env)
# copy to /etc/go-nginx-proxy.env and chmod 600

# bind to loopback: reachable only via the nginx vhost (https://proxy.pradha.id)
PROXY_ADDR=127.0.0.1:8080
PROXY_USERNAME=admin
PROXY_PASSWORD=change-me-now

# run as non-root with passwordless sudo? set to true
# PROXY_SUDO=false

# paths
# PROXY_NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
# PROXY_NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
# PROXY_NGINX_ACCESS_LOG=/var/log/nginx/access.log
# PROXY_NGINX_ERROR_LOG=/var/log/nginx/error.log
# PROXY_USE_SYSTEMCTL=true
# PROXY_SERVICE_NAME=nginx

# certbot
# PROXY_CERTBOT_EMAIL=admin@example.com
# PROXY_CERTBOT_STAGING=false

# cloudflare DNS verification (issues certs via --dns-cloudflare)
# PROXY_CLOUDFLARE_DNS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PROXY_CLOUDFLARE_CREDENTIALS_FILE=/etc/letsencrypt/cloudflare.ini
# PROXY_CLOUDFLARE_PROPAGATION=60
